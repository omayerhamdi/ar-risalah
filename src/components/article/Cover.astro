---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Only the article hero should be eager; cards in a grid stay lazy. */
  priority?: boolean;
  widths?: number[];
  sizes?: string;
}

const { src, alt, priority = false, widths, sizes } = Astro.props;
---
{/* Widths cap at 1216px — 2x the 608px reading column, and nothing ever needs
    more. These covers are grainy film textures, and grain is what AVIF spends
    its bytes on: quality 40 holds the weave and the stitching at 1:1 while
    keeping every variant under the 70kb target, verified by comparing crops
    against the source.

    The wrapper carries the paper wash. Covers come from different sources and
    different prompts; this treatment is what makes them one family. */}
<figure class="cover">
  <Image
    src={src}
    alt={alt}
    widths={widths ?? [400, 640, 1216]}
    sizes={sizes ?? '(min-width: 64rem) 608px, 100vw'}
    format="avif"
    quality={40}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</figure>

<style>
  .cover {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-deep);
    aspect-ratio: 3 / 2;
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.72) contrast(0.96);
  }
  /* Paper-tone wash — the unifier from the design system. */
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #f7f5ef;
    mix-blend-mode: soft-light;
    opacity: 0.28;
    pointer-events: none;
  }
</style>

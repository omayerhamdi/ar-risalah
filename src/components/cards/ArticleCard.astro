---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { bnReadingTime } from '../../lib/dates';

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const d = article.data;

const first = await getEntry(d.authors[0]);
const byline = first?.data.name ?? '';
---
<article class="card matra">
  <p class="eyebrow">{d.category}</p>
  <h3><a href={`/articles/${d.slug}`}>{d.title}</a></h3>
  <p class="excerpt">{d.excerpt}</p>
  <p class="meta">{bnReadingTime(d.readingTime)} · {byline}</p>
</article>

<style>
  /* No background, no shadow, no border on three sides, no transform on hover.
     The rule above the card is the whole idea. */
  .card { position: relative; padding-top: var(--sp-3); }
  .card:hover { border-top-color: var(--ink); }

  h3 {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    margin-top: var(--sp-2);
  }
  h3 a { text-decoration: none; }

  /* The whole card is clickable, but the focus ring stays on the title
     so keyboard users see a ring around something meaningful. */
  h3 a::after { content: ''; position: absolute; inset: 0; }

  .excerpt {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin-top: var(--sp-4);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>

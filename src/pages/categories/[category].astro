---
import Archive from '../../layouts/Archive.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { getPublished, byCategory } from '../../lib/articles';
import { toBn } from '../../lib/toBn';

export async function getStaticPaths() {
  const articles = await getPublished();
  const grouped = byCategory(articles);
  const counts = Object.fromEntries(
    [...grouped.entries()].map(([slug, g]) => [slug, g.articles.length]),
  );
  return [...grouped.entries()].map(([slug, group]) => ({
    params: { category: slug },
    props: { slug, label: group.label, articles: group.articles, counts, total: articles.length },
  }));
}

const { slug, label, articles, counts, total } = Astro.props;
---
<Archive
  title={label}
  eyebrow="বিভাগ"
  lede={`এই বিভাগে ${toBn(articles.length)}টি লেখা।`}
>
  <CategoryFilter active={slug} counts={counts} total={total} />

  <div class="archive-grid">
    {articles.map((a) => <ArticleCard article={a} headingLevel={2} />)}
  </div>
</Archive>

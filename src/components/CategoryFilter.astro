---
import { CATEGORIES } from '../lib/nav';
import { toBn } from '../lib/toBn';

interface Props {
  /** Slug of the active pillar, or 'all'. */
  active: string;
  /** Article count per category slug, plus a `total`. */
  counts: Record<string, number>;
  total: number;
}
const { active, counts, total } = Astro.props;
const shown = CATEGORIES.filter((c) => counts[c.slug]);
---
{/* Plain links, so the row works with scripting off and on every archive page.
    /articles progressively enhances these into in-place filters. */}
<nav class="filters" aria-label="বিভাগ ছাঁকনি" data-filters>
  <a href="/articles" data-filter="all" aria-current={active === 'all' ? 'page' : undefined}>
    <span>সব লেখা</span>
    <span class="n tabular">{toBn(total)}</span>
  </a>
  {shown.map((c) => (
    <a
      href={`/categories/${c.slug}`}
      data-filter={c.slug}
      aria-current={active === c.slug ? 'page' : undefined}
    >
      <span>{c.label}</span>
      <span class="n tabular">{toBn(counts[c.slug])}</span>
    </a>
  ))}
</nav>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--rule);
  }
  .filters a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: var(--tap);
    padding-inline: var(--sp-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease),
                background var(--dur-fast) var(--ease);
  }
  .filters a:hover { border-color: var(--rule-strong); color: var(--ink); }
  .filters a[aria-current='page'] {
    background: var(--deep);
    border-color: var(--deep);
    color: var(--paper);
  }
  .n { color: var(--ink-faint); font-size: 0.9em; }
  .filters a[aria-current='page'] .n {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }
</style>

---
interface Props {
  /** Rendered height in px; the mark stays legible down to 24. */
  height?: number;
  /** Light marks sit on --deep; the default sits on paper. */
  onDark?: boolean;
}
const { height = 34, onDark = false } = Astro.props;
const ink = onDark ? 'var(--paper)' : 'var(--ink)';
---
{/* Typographic only — no imagery. The rule above the wordmark is the matra of
    the Bengali "আ" extended across the whole word: the same gesture the cards
    and sections use, at logo scale. */}
<span class="logo" style={`--logo-h:${height}px; --logo-ink:${ink}`}>
  <span class="matra-line" aria-hidden="true"></span>
  <span class="bn">আর-রিসালাহ</span>
  <span class="ar" lang="ar" dir="rtl" aria-hidden="true">الرسالة</span>
</span>

<style>
  .logo {
    display: inline-grid;
    justify-items: center;
    gap: 0.06em;
    color: var(--logo-ink);
    line-height: 1;
  }
  .matra-line {
    width: 100%;
    border-top: 1px solid currentColor;
    margin-bottom: 0.1em;
  }
  .bn {
    font-family: var(--font-display);
    font-size: var(--logo-h);
    line-height: 1.05;
    white-space: nowrap;
  }
  .ar {
    font-family: var(--font-arabic);
    font-size: calc(var(--logo-h) * 0.42);
    opacity: 0.75;
    line-height: 1.2;
  }
</style>

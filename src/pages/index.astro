---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import TopicCard from '../components/cards/TopicCard.astro';
import AuthorCard from '../components/cards/AuthorCard.astro';
import Cover from '../components/article/Cover.astro';
import { getCover } from '../lib/covers';
import { bnDate, bnReadingTime } from '../lib/dates';
import { toBn } from '../lib/toBn';
import { SITE } from '../lib/nav';

const all = (await getCollection('articles', (a) => a.data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// The lead story sits beside the masthead statement. Prefer a featured pillar.
const lead = all.find((a) => a.data.featured && a.data.pillar) ?? all[0];
const leadCover = getCover(lead.data.slug);
const leadAuthor = await getEntry(lead.data.authors[0]);

// Akhlaq deliberately gets more room than the other pillars.
const akhlaq = all.filter((a) => a.data.categorySlug === 'akhlaq-poribar').slice(0, 3);

// The index list — everything recent that is not already above.
const shown = new Set([lead.id, ...akhlaq.map((a) => a.id)]);
const recent = all.filter((a) => !shown.has(a.id)).slice(0, 6);

// Sidebar rail — topic hubs by how much has been written on each.
const counts = new Map<string, number>();
for (const a of all) for (const t of a.data.topics) counts.set(t, (counts.get(t) ?? 0) + 1);
const topics = [...counts.entries()]
  .filter(([, n]) => n > 1)
  .sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0], 'bn'))
  .slice(0, 8);

const research = all.filter((a) => a.data.hasResearch).slice(0, 3);

const authors = (await getCollection('authors')).sort((a, b) => a.data.order - b.data.order);
const namedAuthors = authors.filter((a) => !a.data.isCollective);

// The three layers every subject passes through. This is the platform's whole
// method, so it sits directly under the masthead rather than on an inner page.
const LAYERS = [
  {
    n: 1,
    title: 'প্রবন্ধ',
    lede: 'যে কেউ পড়তে পারেন।',
    body:
      'এক বসায় শেষ হয়, তবু ফাঁকা কথা থাকে না। প্রতিটি দাবির পেছনে সূত্র ধরিয়ে ' +
      'দেওয়া থাকে, যাতে পাঠক আমাদের কথায় নয়—দলিলে আস্থা রাখেন।',
    href: '/articles',
    cta: 'প্রবন্ধ পড়ুন',
  },
  {
    n: 2,
    title: 'গবেষণা স্তর',
    lede: 'একই বিষয়ের পূর্ণাঙ্গ পাঠ।',
    body:
      'ঐতিহাসিক প্রেক্ষাপট, ফিকহি ইখতিলাফ, আর বিরোধী মতের সবচেয়ে শক্তিশালী রূপটি—' +
      'দুর্বল প্রতিপক্ষ বানিয়ে জিতে যাওয়া ইলমি সততা নয়।',
    href: '/research',
    cta: 'গবেষণা দেখুন',
  },
  {
    n: 3,
    title: 'রিসোর্স আর্কাইভ',
    lede: 'যা কিছু আমরা জড়ো করেছি।',
    body:
      'মূল বইয়ের নথি, বক্তব্যের ক্লিপ, প্রচারপত্র, পুরোনো সংখ্যার স্ক্যান—এক জায়গায় ' +
      'সাজানো। দশ বছর পর যিনি এই বিষয়ে বসবেন, তাঁকে যেন শূন্য থেকে শুরু করতে না হয়।',
    href: '/resources',
    cta: 'আর্কাইভ ঘুরে দেখুন',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE.name,
      alternateName: SITE.nameArabic,
      description: SITE.tagline,
      url: Astro.site?.href,
    },
    {
      '@type': 'WebSite',
      name: SITE.name,
      url: Astro.site?.href,
      inLanguage: 'bn',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: new URL('/search?q={search_term_string}', Astro.site).href },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<Base
  title={`${SITE.name} — ${SITE.tagline}`}
  description="সুন্নাহ ও মাকাসিদে শরিয়াহর আলোকে প্রজন্ম গঠনের দাওয়াহ ও গবেষণা কেন্দ্র। প্রতিটি বিষয়ে প্রবন্ধ, গবেষণা স্তর ও উৎসের আর্কাইভ—সঙ্গে খুতবার খসড়া ও বিতরণযোগ্য লিফলেট।"
>
  {/* Front page: the statement on the left, the lead story on the right. */}
  <section class="front" aria-labelledby="front-heading">
    <div class="container front-grid">
      <div class="statement">
        <p class="kicker">দাওয়াহ ও গবেষণা কেন্দ্র</p>
        <h1 id="front-heading">যে প্রজন্ম প্রশ্ন করে, তাকে উত্তরও দিতে হয়</h1>
        <p class="lede">
          আর-রিসালাহ কাজ করে সুন্নাহ ও মাকাসিদে শরিয়াহর আলোকে। আমরা এক বিষয়ে
          তিনবার কাজ করি—পাঠকের জন্য প্রবন্ধ, গবেষকের জন্য পূর্ণাঙ্গ পাঠ, আর
          ভবিষ্যতের জন্য উৎসের আর্কাইভ।
        </p>
        <p class="cta">
          <a class="btn-primary" href="/start-here">শুরু করুন এখান থেকে</a>
          <a class="btn-secondary" href="/about">আমাদের কাজের ধরন</a>
        </p>
        <p class="stats">
          <span>{toBn(all.length)}টি প্রবন্ধ</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{toBn(namedAuthors.length)} জন লেখক</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>প্রতি বৃহস্পতিবার নতুন লেখা</span>
        </p>
      </div>

      <article class="lead">
        <a class="lead-cover" href={`/articles/${lead.data.slug}`} tabindex="-1" aria-hidden="true">
          {leadCover && (
            <Cover
              src={leadCover}
              alt=""
              priority={true}
              widths={[480, 800, 1216]}
              sizes="(min-width: 64rem) 620px, 100vw"
            />
          )}
        </a>
        <p class="lead-kicker">
          <span class="rubric">এ সপ্তাহের লেখা</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>{lead.data.category}</span>
        </p>
        <h2 class="lead-title">
          <a href={`/articles/${lead.data.slug}`}>{lead.data.title}</a>
        </h2>
        <p class="lead-excerpt">{lead.data.excerpt}</p>
        <p class="lead-meta">
          {leadAuthor?.data.name} · {bnDate(lead.data.publishedAt)} ·
          {' '}{bnReadingTime(lead.data.readingTime)} পড়া
        </p>
      </article>
    </div>
  </section>

  {/* The method. This is what separates the platform from a blog, so it comes
      before any further article listing. */}
  <section class="band layers" aria-labelledby="layers-heading">
    <div class="container">
      <div class="band-head wide">
        <h2 id="layers-heading">এক বিষয়, তিন স্তর</h2>
        <p class="band-lede">
          একটি বিষয় একবার পড়ে শেষ হয় না। যিনি সাধারণ পাঠক, যিনি গবেষক, আর যিনি
          দশ বছর পর এই বিষয়েই কাজ করতে বসবেন—তিনজনের প্রয়োজন তিন রকম। আমরা
          তিনটাই তৈরি করি।
        </p>
      </div>
      <ol class="layer-grid">
        {LAYERS.map((l) => (
          <li class="layer">
            <p class="layer-num tabular" aria-hidden="true">{toBn(l.n).padStart(2, '০')}</p>
            <h3 class="layer-title">{l.title}</h3>
            <p class="layer-lede">{l.lede}</p>
            <p class="layer-body">{l.body}</p>
            <p class="layer-cta"><a href={l.href}>{l.cta} →</a></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {akhlaq.length > 0 && (
    <section class="band" aria-labelledby="akhlaq-heading">
      <div class="container">
        <div class="band-head row">
          <div>
            <h2 id="akhlaq-heading">আখলাক ও পরিবার</h2>
            <p class="band-lede">
              সংশোধনের প্রথম ময়দান মসজিদ নয়, নিজের ঘর। যে আচরণ ঘরে তৈরি হয় না,
              সেটি ওয়াজ শুনে তৈরি হয় না।
            </p>
          </div>
          <a class="band-more" href="/categories/akhlaq-poribar">এই বিভাগের সব লেখা →</a>
        </div>
        <div class="grid-3">
          {akhlaq.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>
    </section>
  )}

  {/* The one dark surface above the footer. It carries what the platform hands
      to khateebs and to organisations — the part that leaves the website. */}
  <section class="minbar" aria-labelledby="minbar-heading">
    <div class="container minbar-grid">
      <div class="minbar-text">
        <p class="kicker-light">খতীব, দাঈ ও সচেতন সংগঠনের জন্য</p>
        <h2 id="minbar-heading">মিম্বার পর্যন্ত পৌঁছালে কাজটা আসলে শুরু হয়</h2>
        <p>
          একটি লেখা পড়ে দশজন নড়েচড়ে বসেন। সেই কথা যদি জুমার খুতবায় ওঠে, শোনেন
          তিনশ জন। তাই প্রতিটি গুরুত্বপূর্ণ বিষয়ের সঙ্গে আমরা আগেই তৈরি করে রাখি—
        </p>
      </div>

      <ul class="offers">
        <li>
          <p class="offer-title">খুতবার পূর্ণাঙ্গ খসড়া</p>
          <p class="offer-body">
            প্রাসঙ্গিক আয়াত, হাদিস ও তার তাখরিজসহ সাজানো—ভূমিকা থেকে দুআ পর্যন্ত।
            ছাপিয়ে নিয়ে মিম্বারে দাঁড়ানো যায়।
          </p>
          <a class="btn-download" href="/for-khateebs">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <path d="M12 4v11m0 0 4-4m-4 4-4-4M4 19h16" />
            </svg>
            খুতবার খসড়া দেখুন
          </a>
        </li>
        <li>
          <p class="offer-title">বিতরণযোগ্য লিফলেট</p>
          <p class="offer-body">
            এক পাতার, সংক্ষিপ্ত। মসজিদ কমিটি, মাদরাসা বা সচেতন সংগঠন ছাপিয়ে
            বিলি করতে পারেন—ছাপার উপযোগী ফাইলসহ।
          </p>
          <a class="btn-download" href="/for-khateebs">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <path d="M12 4v11m0 0 4-4m-4 4-4-4M4 19h16" />
            </svg>
            লিফলেট দেখুন
          </a>
        </li>
      </ul>

      {/* After the list, not before it — the sentence above ends in a dash and
          hands straight over to the two offers. */}
      <p class="minbar-note">
        ব্যবহারে অনুমতি লাগে না, ফি নেই। শুধু উৎসটুকু উল্লেখ করবেন।
      </p>
    </div>
  </section>

  {/* Index list plus a rail — a different rhythm from the card grids above. */}
  <section class="band" aria-labelledby="recent-heading">
    <div class="container main-grid">
      <div>
        <div class="band-head row">
          <h2 id="recent-heading">সাম্প্রতিক লেখা</h2>
          <a class="band-more" href="/articles">সব প্রবন্ধ →</a>
        </div>
        <ol class="index-list">
          {recent.map((a, i) => (
            <li class="index-item">
              <span class="index-num tabular" aria-hidden="true">{toBn(i + 1).padStart(2, '০')}</span>
              <div class="index-body">
                <p class="index-cat">{a.data.category}</p>
                <h3 class="index-title"><a href={`/articles/${a.data.slug}`}>{a.data.title}</a></h3>
                <p class="index-excerpt">{a.data.excerpt}</p>
                <p class="index-meta">
                  {bnReadingTime(a.data.readingTime)} পড়া
                  {a.data.hasResearch && <span class="tag">গবেষণা স্তর আছে</span>}
                  {a.data.hasKhutbahResource && <span class="tag">খুতবা প্রস্তুত</span>}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="rail" aria-label="বিষয়, গবেষণা ও যুক্ত হওয়ার সুযোগ">
        {/* Capture point one. The second is the footer's join block. */}
        <div class="rail-block join">
          <h2 class="rail-heading">সপ্তাহে একটি লেখা</h2>
          <p class="rail-lede">
            প্রতি বৃহস্পতিবার সকালে—জুমার আগের দিন, ইচ্ছা করেই। এর বেশি
            আমরা আপনাকে বিরক্ত করি না।
          </p>
          <form class="join-form" method="post" action="#" aria-label="নিউজলেটারে যুক্ত হোন">
            <label class="visually-hidden" for="home-email">ইমেইল ঠিকানা</label>
            <input id="home-email" type="email" name="email" autocomplete="email"
                   placeholder="ইমেইল ঠিকানা" />
            <button type="submit">যুক্ত হোন</button>
          </form>
          <p class="join-alt">
            <a href="/subscribe">হোয়াটসঅ্যাপে পেতে চান? →</a>
          </p>
        </div>

        {topics.length > 0 && (
          <div class="rail-block">
            <h2 class="rail-heading">বিষয় ধরে পড়ুন</h2>
            <div class="rail-topics">
              {topics.map(([t, n]) => <TopicCard topic={t} count={n} />)}
            </div>
            <p class="more"><a href="/topics">সব বিষয় →</a></p>
          </div>
        )}

        {research.length > 0 && (
          <div class="rail-block">
            <h2 class="rail-heading">গবেষণা স্তর</h2>
            <ul class="rail-list">
              {research.map((a) => (
                <li>
                  <a href={`/articles/${a.data.slug}`}>{a.data.titleShort ?? a.data.title}</a>
                </li>
              ))}
            </ul>
            <p class="more"><a href="/research">সব গবেষণা →</a></p>
          </div>
        )}
      </aside>
    </div>
  </section>

  <section class="band" aria-labelledby="authors-heading">
    <div class="container">
      <div class="band-head row">
        <div>
          <h2 id="authors-heading">যাঁরা লিখছেন</h2>
          <p class="band-lede">
            নাম গোপন রেখে লেখা হয় না। কে লিখছেন, কোন পড়াশোনার ওপর দাঁড়িয়ে
            লিখছেন—পাঠকের তা জানার অধিকার আছে।
          </p>
        </div>
        <a class="band-more" href="/authors">সবার পরিচয় →</a>
      </div>
      <div class="grid-authors">
        {authors.map((a) => <AuthorCard author={a} />)}
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  /* ---- Front page ------------------------------------------------ */
  .front { padding-block: var(--sp-7) var(--sp-8); }
  .front-grid { display: grid; gap: var(--sp-7); }

  .kicker {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--rubric);
    margin-bottom: var(--sp-4);
  }
  .statement h1 {
    font-size: var(--step-5);
    line-height: 1.18;
    letter-spacing: -0.01em;
    max-width: 17ch;
  }
  .statement .lede {
    margin-top: var(--sp-5);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
    max-width: 42ch;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .stats .dot { color: var(--rule-strong); }

  .cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }
  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--sp-5);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }
  .btn-primary { background: var(--deep); color: var(--paper); }
  .btn-primary:hover { background: var(--deep-2); }
  .btn-secondary { border: 1px solid var(--rule-strong); color: var(--ink); }
  .btn-secondary:hover { border-color: var(--ink); background: var(--paper-raise); }

  .lead { position: relative; }
  .lead-cover { display: block; margin-bottom: var(--sp-5); }
  .lead-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .lead-kicker .rubric { color: var(--rubric); }
  .lead-kicker .sep { color: var(--rule-strong); }
  .lead-title {
    margin-top: var(--sp-3);
    font-size: var(--step-3);
    line-height: var(--leading-snug);
  }
  .lead-title a { text-decoration: none; }
  .lead-title a::after { content: ''; position: absolute; inset: 0; }
  .lead-excerpt {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    line-height: var(--leading-snug);
  }

---
import Page from '../layouts/Page.astro';
import ContactForm from '../components/forms/ContactForm.astro';
---
<Page
  title="আমাদের সঙ্গে যোগাযোগ"
  metaTitle="যোগাযোগ — আর-রিসালাহ"
  eyebrow="যোগাযোগ"
  lede="প্রশ্ন, পরামর্শ, সংশোধনী কিংবা একসঙ্গে কাজ করার প্রস্তাব—সবই স্বাগত।"
>
  <ContactForm />

  <h2>লেখা জমা দিতে চান?</h2>
  <p>আমরা বাইরের লেখা প্রকাশ করি। শর্ত—দলিলভিত্তিক, প্রাসঙ্গিক এবং আমাদের সম্পাদকীয় পদ্ধতির সঙ্গে সংগতিপূর্ণ। প্রথমে বিষয় ও এক অনুচ্ছেদের সারসংক্ষেপ পাঠান, সম্পূর্ণ লেখা নয়।</p>

  <h2>সংশোধনী পাঠাতে চান?</h2>
  <p>কোনো তথ্য, দলিল বা উদ্ধৃতিতে ভুল পেলে জানান। যাচাই করে সংশোধন করা হবে এবং লেখার নিচে সংশোধনের তারিখ উল্লেখ থাকবে।</p>

  <h2>উত্তরের সময়</h2>
  <p>আমরা সাধারণত তিন কর্মদিবসের মধ্যে উত্তর দিই।</p>
</Page>

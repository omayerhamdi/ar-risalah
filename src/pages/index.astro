<script>
  // The method stepper. Panels start visible; the script collapses them to one
  // at a time, so a reader without JS still gets all five.
  const root = document.querySelector<HTMLElement>('[data-stepper]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

    const select = (i: number) => {
      tabs.forEach((t, n) => {
        t.setAttribute('aria-selected', String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      panels.forEach((p, n) => { p.hidden = n !== i; });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const next = (i + d + tabs.length) % tabs.length;
        select(next);
        tabs[next].focus();
      });
    });

    root.classList.add('is-live');
    select(0);
  }
</script>


---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/cards/AuthorCard.astro';
import TopicCard from '../components/cards/TopicCard.astro';
import Cover from '../components/article/Cover.astro';
import Icon from '../components/Icon.astro';
import { getCover } from '../lib/covers';
import { bnDate, bnReadingTime } from '../lib/dates';
import { toBn } from '../lib/toBn';
import { SITE } from '../lib/nav';

const all = (await getCollection('articles', (a) => a.data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const lead = all.find((a) => a.data.featured && a.data.pillar) ?? all[0];
const leadCover = getCover(lead.data.slug);
const leadAuthor = await getEntry(lead.data.authors[0]);

const recent = all.filter((a) => a.id !== lead.id).slice(0, 4);

const counts = new Map<string, number>();
for (const a of all) for (const t of a.data.topics) counts.set(t, (counts.get(t) ?? 0) + 1);
const topics = [...counts.entries()]
  .filter(([, n]) => n > 1)
  .sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0], 'bn'))
  .slice(0, 8);

const research = all.filter((a) => a.data.hasResearch).slice(0, 3);
const authors = (await getCollection('authors')).sort((a, b) => a.data.order - b.data.order);

/* ---- Section data ------------------------------------------------------ */

// "কেন আর-রিসালাহ?" — the four people the platform is written for.
const READERS = [
  { icon: 'question', text: 'একজন তরুণ যখন কোনো সংশয় নিয়ে প্রশ্ন করেন' },
  { icon: 'parents', text: 'একজন বাবা যখন সন্তানের চরিত্র নিয়ে চিন্তা করেন' },
  { icon: 'board', text: 'একজন শিক্ষক যখন শিক্ষার্থীর মূল্যবোধ নিয়ে ভাবেন' },
  { icon: 'family', text: 'একটি পরিবার যখন সম্পর্কের টানাপোড়েনে পড়ে' },
];

const PILLARS = [
  {
    icon: 'home',
    title: 'আখলাক ও পরিবার',
    body:
      'দাম্পত্য, সন্তান প্রতিপালন, পিতা-মাতার সঙ্গে সম্পর্ক, আত্মীয়তার বন্ধন, ' +
      'প্রতিবেশীর অধিকার—এসব পরিচিত বিষয়। কিন্তু পরিচিত বিষয় মানেই সহজ বিষয় নয়। ' +
      'আমরা এসব সম্পর্ককে আবেগের বদলে ইসলামের নৈতিক শিক্ষা, দায়িত্ববোধ ও বাস্তব ' +
      'জীবনের আলোকে বুঝতে চাই।',
    href: '/categories/akhlaq-poribar',
    cta: 'এই বিষয়ের লেখা দেখুন',
  },
  {
    icon: 'compass',
    title: 'চিন্তা ও মতবাদ',
    body:
      'ব্যক্তিস্বাতন্ত্র্য, ভোগবাদ, বস্তুবাদ, আধুনিকতা, ধর্মনিরপেক্ষতা—এসব নিয়ে কথা ' +
      'বলার আগে এগুলো কী, কীভাবে তৈরি হয়েছে এবং আমাদের চিন্তাকে কীভাবে প্রভাবিত করে, ' +
      'সেটা বোঝা জরুরি। আমরা তর্কের জন্য তর্ক করতে চাই না।',
    href: '/categories/chinta-motobad',
    cta: 'চিন্তা ও মতবাদ নিয়ে পড়ুন',
  },
  {
    icon: 'device',
    title: 'যুবসমাজ ও সমকাল',
    body:
      'পরিচয়, ক্যারিয়ার, সম্পর্ক, সামাজিক যোগাযোগমাধ্যম, প্রযুক্তি, মানসিক চাপ, ' +
      'স্বাধীনতার ধারণা কিংবা ভবিষ্যৎ নিয়ে অনিশ্চয়তা—এসব আজকের তরুণদের দৈনন্দিন ' +
      'জীবনের অংশ। প্রশ্নকে বুঝতে হবে, তারপর উত্তর দিতে হবে।',
    href: '/categories/jubosomaj-somokal',
    cta: 'যুবসমাজ ও সমকাল',
  },
  {
    icon: 'book',
    title: 'ইলম ও জীবনদর্শন',
    body:
      'কী জানব, কেন জানব, জানা জিনিস আমাদের জীবনকে কীভাবে বদলাবে এবং সত্য ও ভুলের ' +
      'মধ্যে পার্থক্য কীভাবে করব—এসবও ইলমের আলোচনার অংশ। সঙ্গে থাকে জ্ঞান ও আমলের ' +
      'সম্পর্ক, দুনিয়া ও আখিরাতের ভারসাম্য এবং জীবনের উদ্দেশ্য।',
    href: '/categories/ilm-jibondorshon',
    cta: 'ইলম ও জীবনদর্শন',
  },
];

const LAYERS = [
  {
    icon: 'article',
    title: 'সহজপাঠ্য প্রবন্ধ',
    body: 'বিষয়ের মূল কথাটি সহজ ও পরিষ্কার ভাষায় বোঝানোর জন্য।',
    who: 'যিনি প্রথমবার বিষয়টি সম্পর্কে জানতে চান',
  },
  {
    icon: 'magnifier',
    title: 'গবেষণা ও রেফারেন্স',
    body:
      'আরও গভীরে যেতে চান যাঁরা, তাঁদের জন্য বিস্তৃত আলোচনা, প্রাসঙ্গিক সূত্র, ' +
      'ঐতিহাসিক প্রেক্ষাপট ও মতভেদের পরিচয়।',
    who: 'যিনি দলিল ও মতভেদ জানতে চান',
  },
  {
    icon: 'archive',
    title: 'রিসোর্স আর্কাইভ',
    body:
      'প্রয়োজনীয় বই, নথি, পুরোনো প্রকাশনা ও অন্যান্য উপকরণ ধীরে ধীরে এক জায়গায় ' +
      'সংরক্ষণ করার একটি প্রচেষ্টা।',
    who: 'যে শিক্ষক, গবেষক বা খতীব আরও গভীরে কাজ করতে চান',
  },
];

// The editorial method, as five steps. Rendered as a stepper the reader clicks
// through — five stacked paragraphs would read as filler.
const METHOD = [
  {
    label: 'বাস্তবতা',
    title: 'প্রথমে বাস্তবতা।',
    body: 'সমস্যাটি আসলে কী এবং মানুষের জীবনে এটি কীভাবে দেখা দিচ্ছে?',
  },
  {
    label: 'বিশ্লেষণ',
    title: 'তারপর বিশ্লেষণ।',
    body: 'সমস্যার পেছনে কোন চিন্তা, অভ্যাস, সামাজিক বাস্তবতা বা ধারণা কাজ করছে?',
  },
  {
    label: 'দলিল',
    title: 'এরপর দলিল।',
    body:
      'কুরআন, সহিহ সুন্নাহ, নির্ভরযোগ্য তাফসির, ফিকহ ও আলেমদের ব্যাখ্যার আলোকে ' +
      'বিষয়টি দেখা।',
  },
  {
    label: 'তুলনা',
    title: 'তারপর তুলনা।',
    body:
      'প্রচলিত ধারণা এবং ইসলামের দৃষ্টিভঙ্গির মধ্যে কোথায় মিল, কোথায় পার্থক্য—' +
      'তা পরিষ্কার করা।',
  },
  {
    label: 'করণীয়',
    title: 'সবশেষে করণীয়।',
    body:
      'আলোচনা যেন শুধু পড়ে ভালো লাগার মধ্যে শেষ না হয়; সম্ভব হলে পাঠক যেন বুঝতে ' +
      'পারেন, এখান থেকে তাঁর কী শেখার বা করার আছে।',
  },
];

const EVIDENCE = [
  'কুরআনের আয়াত সঠিক সূত্রে উপস্থাপন করতে',
  'হাদিসের উৎস ও মান যাচাই করতে',
  'আলেমদের বক্তব্য যথাযথ প্রেক্ষাপটে তুলে ধরতে',
  'মতভেদ থাকলে সেটিকে মতভেদ হিসেবেই উপস্থাপন করতে',
  'এবং যেখানে একাধিক মত রয়েছে, সেখানে পাঠকের কাছে বিষয়টি স্পষ্ট রাখতে',
];

const KHATEEB = [
  { icon: 'mic', text: 'একজন খতীব জুমার খুতবায় একটি বিষয় নিয়ে কথা বলতে পারেন।' },
  { icon: 'board', text: 'একজন শিক্ষক ছাত্রদের সঙ্গে আলোচনা করতে পারেন।' },
  { icon: 'leaflet', text: 'একটি সংগঠন একটি সচেতনতামূলক লিফলেট তৈরি করতে পারে।' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: SITE.name,
      alternateName: SITE.nameArabic,
      description: SITE.tagline,
      url: Astro.site?.href,
    },
    {
      '@type': 'WebSite',
      name: SITE.name,
      url: Astro.site?.href,
      inLanguage: 'bn',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: new URL('/search?q={search_term_string}', Astro.site).href },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<Base
  title={`${SITE.name} — ইসলামকে শুধু জানা নয়, বোঝা ও প্রয়োগ করা`}
  description="দাওয়াহ, চিন্তা ও গবেষণা। কুরআন ও সুন্নাহর আলোচনার সঙ্গে ইতিহাস, সমাজ ও সমকালীন বাস্তবতার পরিচয়—প্রয়োজনীয় দলিলসহ, স্বাভাবিক ও পাঠযোগ্য ভাষায়।"
>
  <!-- ১ | ভূমিকা -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <p class="kicker">দাওয়াহ, চিন্তা ও গবেষণা</p>
      <h1 id="hero-heading">
        ইসলামকে শুধু জানা নয়—বোঝা, ভাবা এবং জীবনে প্রয়োগ করা
      </h1>
      <div class="hero-body">
        <p>
          আমরা এমন এক সময়ে বাস করছি, যখন তথ্যের অভাব নেই; কিন্তু সঠিকভাবে বোঝার
          সুযোগ খুব কম। ইসলাম নিয়েও একই বাস্তবতা আছে। কোথাও আমরা পাই খুব সংক্ষিপ্ত
          আবেগনির্ভর কথা, কোথাও পাই এত দীর্ঘ ও জটিল আলোচনা যে সাধারণ পাঠকের কাছে
          তা দূরবর্তী হয়ে যায়।
        </p>
        <p class="hero-turn">আর-রিসালাহ সেই ব্যবধানটি কমাতে চায়।</p>
        <p>
          বাংলা ভাষায় আমরা এমন লেখা তৈরি করতে চাই, যেখানে কুরআন ও সুন্নাহর
          আলোচনার সঙ্গে থাকবে ইতিহাস, সমাজ, চিন্তা ও সমকালীন বাস্তবতার পরিচয়;
          থাকবে প্রয়োজনীয় দলিল, কিন্তু ভাষা হবে স্বাভাবিক ও পাঠযোগ্য।
        </p>
      </div>
      <p class="cta">
        <a class="btn-primary" href="/articles">প্রবন্ধ পড়ুন</a>
        <a class="btn-secondary" href="/about">আমাদের সম্পর্কে জানুন</a>
      </p>
    </div>
  </section>

  <!-- ২ | কেন আর-রিসালাহ -->
  <section class="band why" aria-labelledby="why-heading">
    <div class="container why-grid">
      <div class="why-text">
        <h2 id="why-heading">কেন আর-রিসালাহ?</h2>
        <p>
          ইসলাম শুধু কিছু মতামত, কিছু বিধান কিংবা কিছু উপদেশের নাম নয়। ইসলাম
          মানুষের বিশ্বাসকে যেমন গড়ে, তেমনি তার চিন্তা, চরিত্র, পরিবার, সমাজ ও
          জীবনযাপনকেও প্রভাবিত করে।
        </p>
        <p>তাই আমাদের অনেক প্রশ্নের উত্তর কেবল একটি উদ্ধৃতি দিয়ে শেষ হয় না।</p>
      </div>

      <div class="why-list">
        <ul class="readers">
          {READERS.map((r) => (
            <li>
              <span class="ic" aria-hidden="true"><Icon name={r.icon} size={20} /></span>
              <span>{r.text}</span>
            </li>
          ))}
          </ul>
        <p class="why-close">
          —তখন আমাদের দরকার এমন আলোচনা, যা সমস্যাটিকে বুঝবে এবং ইসলামের আলোকে
          তার দিকে তাকাবে। <strong>আর-রিসালাহ সেই কাজটিই করতে চায়।</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- ৩ | আমরা কী নিয়ে কাজ করি -->
  <section class="band" aria-labelledby="pillars-heading">
    <div class="container">
      <div class="band-head">
        <h2 id="pillars-heading">আমরা কী নিয়ে কাজ করি</h2>
        <p class="band-lede">
          চারটি ময়দান। প্রতিটির শুরু বাস্তব প্রশ্ন থেকে, শেষ কুরআন ও সুন্নাহর
          আলোয়।
        </p>
      </div>
      <ul class="pillars">
        {PILLARS.map((p) => (
          <li class="pillar">
            <span class="ic-tile" aria-hidden="true"><Icon name={p.icon} size={24} /></span>
            <h3>{p.title}</h3>
            <p class="pillar-body">{p.body}</p>
            <a class="pillar-cta" href={p.href}>{p.cta} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ৪ | এই সপ্তাহের লেখা -->
  <section class="band" aria-labelledby="feature-heading">
    <div class="container">
      <div class="band-head row">
        <h2 id="feature-heading">এই সপ্তাহের লেখা</h2>
        <a class="band-more" href="/articles">সব প্রবন্ধ দেখুন →</a>
      </div>
      <article class="feature">
        <a class="feature-cover" href={`/articles/${lead.data.slug}`} tabindex="-1" aria-hidden="true">
          {leadCover && (
            <Cover
              src={leadCover}
              alt=""
              priority={true}
              widths={[480, 800, 1216]}
              sizes="(min-width: 64rem) 600px, 100vw"
            />
          )}
        </a>
        <div class="feature-text">
          <p class="eyebrow">{lead.data.category}</p>
          <h3><a href={`/articles/${lead.data.slug}`}>{lead.data.title}</a></h3>
          <p class="feature-excerpt">{lead.data.excerpt}</p>
          <p class="feature-meta">
            {leadAuthor?.data.name} · {bnDate(lead.data.publishedAt)} ·
            {' '}{bnReadingTime(lead.data.readingTime)} পড়া
          </p>
          <p class="feature-cta"><span class="btn-secondary">প্রবন্ধটি পড়ুন</span></p>
        </div>
      </article>
    </div>
  </section>

  <!-- ৫ | তিন স্তর -->
  <section class="band layers" aria-labelledby="layers-heading">
    <div class="container">
      <div class="band-head wide">

---
interface Props {
  /** Rendered height in px; the mark stays legible down to 20. */
  height?: number;
  /** Light marks sit on --deep; the default sits on paper. */
  onDark?: boolean;
}
const { height = 34, onDark = false } = Astro.props;
const ink = onDark ? 'var(--paper)' : 'var(--ink)';
---
{/* The wordmark is the whole mark: the Bengali name set in the display face,
    nothing above it and nothing beneath it. */}
<span class="logo" style={`--logo-h:${height}px; --logo-ink:${ink}`}>আর-রিসালাহ</span>

<style>
  .logo {
    display: inline-block;
    color: var(--logo-ink);
    font-family: var(--font-display);
    font-size: var(--logo-h);
    line-height: 1.15;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>

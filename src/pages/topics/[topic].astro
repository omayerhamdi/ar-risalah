---
import Archive from '../../layouts/Archive.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getPublished, byTopic } from '../../lib/articles';
import { toBn } from '../../lib/toBn';

export async function getStaticPaths() {
  const articles = await getPublished();
  return [...byTopic(articles).entries()].map(([topic, list]) => ({
    // Topic names are Bengali, so these URLs are percent-encoded. Unlike
    // article slugs they are not shared by hand, so legibility matters less
    // than keeping one durable address per topic.
    params: { topic },
    props: { topic, articles: list },
  }));
}

const { topic, articles } = Astro.props;
const related = [...new Set(articles.flatMap((a) => a.data.topics))]
  .filter((t) => t !== topic)
  .slice(0, 10);
---
<Archive
  title={topic}
  metaTitle={`${topic} — আর-রিসালাহ`}
  eyebrow="বিষয়"
  lede={`এই বিষয়ে ${toBn(articles.length)}টি লেখা।`}
>
  <div class="archive-grid">
    {articles.map((a) => <ArticleCard article={a} headingLevel={2} />)}
  </div>

  {related.length > 0 && (
    <nav class="related-topics" aria-label="সংশ্লিষ্ট বিষয়">
      <p class="label">সংশ্লিষ্ট বিষয়</p>
      <ul>
        {related.map((t) => (
          <li><a href={`/topics/${encodeURIComponent(t)}`}>{t}</a></li>
        ))}
      </ul>
    </nav>
  )}
</Archive>

<style>
  .related-topics {
    margin-top: var(--sp-8);
    border-top: 1px solid var(--rule);
    padding-top: var(--sp-4);
  }
  .label { font-family: var(--font-ui); font-size: var(--step--1); color: var(--rubric); }
  ul { list-style: none; margin: var(--sp-3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  a {
    display: inline-flex; align-items: center;
    min-height: var(--tap); padding-inline: var(--sp-3);
    border: 1px solid var(--rule); border-radius: var(--radius);
    font-family: var(--font-ui); font-size: var(--step--1);
    color: var(--ink-soft); text-decoration: none;
  }
  a:hover { border-color: var(--ink); color: var(--ink); }
</style>

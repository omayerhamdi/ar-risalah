---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { bnReadingTime } from '../../lib/dates';
import Cover from '../article/Cover.astro';
import { getCover } from '../../lib/covers';

interface Props {
  article: CollectionEntry<'articles'>;
  /**
   * Heading level for the card title. Default h3 suits a card sitting under a
   * section h2; archive pages pass 2 because the card sits directly under the
   * page h1 and an h1 → h3 gap is a real screen-reader problem.
   */
  headingLevel?: 2 | 3 | 4;
}
const { article, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const d = article.data;

const first = await getEntry(d.authors[0]);
const byline = first?.data.name ?? '';
const cover = getCover(d.slug);
---
<article class="card">
  {cover && (
    <div class="card-cover">
      <Cover
        src={cover}
        alt={d.cover.alt}
        widths={[320, 480, 640]}
        sizes="(min-width: 64rem) 380px, (min-width: 48rem) 45vw, 90vw"
      />
    </div>
  )}
  <div class="matra card-text">
  <p class="eyebrow">{d.category}</p>
  <Heading class="card-title"><a href={`/articles/${d.slug}`}>{d.title}</a></Heading>
  <p class="excerpt">{d.excerpt}</p>
  <p class="meta">{bnReadingTime(d.readingTime)} · {byline}</p>
  </div>
</article>

<style>
  /* No background, no shadow, no border on three sides, no transform on hover.
     The rule above the card is the whole idea. */
  .card { position: relative; }
  .card-cover { margin-bottom: var(--sp-3); }
  .card-text { padding-top: var(--sp-3); }
  .card:hover .card-text { border-top-color: var(--ink); }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--ink);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    margin-top: var(--sp-2);
  }
  .card-title a { text-decoration: none; }

  /* The whole card is clickable, but the focus ring stays on the title
     so keyboard users see a ring around something meaningful. */
  .card-title a::after { content: ''; position: absolute; inset: 0; }

  .excerpt {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    margin-top: var(--sp-4);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    /* The card spec in the design system asks for --ink-faint here, but its
       own colour rules forbid --ink-faint on readable content — and reading
       time and byline are readable content. --ink-soft is 5.52:1. */
    color: var(--ink-soft);
  }
</style>

# Email list endpoint (Buttondown, a Cloudflare Worker, or anything that accepts
# a POST with an `email` field). Until this is set, the subscribe section shows
# only the WhatsApp route — a form that silently discards addresses is worse
# than no form.
PUBLIC_SUBSCRIBE_ENDPOINT=

# WhatsApp channel or group invite link.
PUBLIC_WHATSAPP_CHANNEL=

# Contact form endpoint (POST with name, email, whatsapp, subject, message,
# subscribe). Until this is set the contact page shows the fallback address
# below instead of a form that would swallow the message.
PUBLIC_CONTACT_ENDPOINT=

# Fallback address shown when PUBLIC_CONTACT_ENDPOINT is unset.
PUBLIC_CONTACT_EMAIL=

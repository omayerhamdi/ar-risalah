---
/**
 * Like the subscribe form, this only renders its fields when an endpoint
 * exists. A contact form that swallows a correction notice is worse than a
 * mailto link, because the reader believes the correction was filed.
 */
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;
const email = import.meta.env.PUBLIC_CONTACT_EMAIL;

const SUBJECTS = [
  'সাধারণ প্রশ্ন',
  'লেখা জমা দিতে চাই',
  'কোনো তথ্য বা দলিলে সংশোধনী',
  'গবেষণা সহযোগিতা',
  'মাহফিল বা কার্যক্রমের ঘোষণা',
  'অন্য কিছু',
];
---
{endpoint ? (
  <form class="contact" method="post" action={endpoint}>
    <div class="field">
      <label for="c-name">আপনার নাম <span aria-hidden="true">*</span></label>
      <input id="c-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="field">
      <label for="c-email">ইমেইল <span aria-hidden="true">*</span></label>
      <input id="c-email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="field">
      <label for="c-whatsapp">হোয়াটসঅ্যাপ নম্বর <span class="opt">(ঐচ্ছিক)</span></label>
      <input id="c-whatsapp" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" />
    </div>

    <fieldset class="field">
      <legend>কী বিষয়ে? <span aria-hidden="true">*</span></legend>
      {SUBJECTS.map((s, i) => (
        <div class="radio">
          <input id={`c-subject-${i}`} name="subject" type="radio" value={s} required={i === 0} />
          <label for={`c-subject-${i}`}>{s}</label>
        </div>
      ))}
    </fieldset>

    <div class="field">
      <label for="c-message">বার্তা <span aria-hidden="true">*</span></label>
      <textarea id="c-message" name="message" rows="6" required></textarea>
    </div>

    <div class="checkbox">
      <input id="c-subscribe" name="subscribe" type="checkbox" value="yes" />
      <label for="c-subscribe">নতুন লেখার খবর পেতে চাই</label>
    </div>

    <button type="submit">বার্তা পাঠান</button>
  </form>
) : (
  <p class="no-endpoint">
    যোগাযোগ ফর্মটি এখনো সংযুক্ত হয়নি।
    {email && <> ততক্ষণ সরাসরি লিখুন: <a href={`mailto:${email}`}>{email}</a></>}
  </p>
)}

<style>
  .contact { display: grid; gap: var(--sp-5); max-width: var(--measure); }
  .field { display: grid; gap: var(--sp-2); border: 0; padding: 0; margin: 0; }
  label, legend {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-body);
    padding: 0;
  }
  .opt { color: var(--ink-soft); }
  input[type='text'], input[type='email'], input[type='tel'], textarea {
    min-height: var(--tap);
    padding: var(--sp-2) var(--sp-3);
    background: var(--paper-raise);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
  }
  textarea { resize: vertical; }

  .radio, .checkbox {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: var(--tap);
  }
  .radio input, .checkbox input { width: 18px; height: 18px; accent-color: var(--deep); }
  .radio label, .checkbox label { color: var(--ink-body); }
  fieldset.field { gap: 0; }
  fieldset legend { margin-bottom: var(--sp-2); }

  button {
    justify-self: start;
    min-height: var(--tap);
    padding-inline: var(--sp-5);
    background: var(--deep);
    color: var(--paper);
    border: 0;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    cursor: pointer;
  }
  button:hover { background: var(--deep-2); }

  .no-endpoint {
    padding: var(--sp-5);
    background: var(--paper-deep);
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
</style>

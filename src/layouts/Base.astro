---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBar from '../components/layout/MobileBar.astro';

interface Props {
  title: string;
  description?: string;
  /** Preload Amiri too. Only set on pages that render Arabic above the fold. */
  arabic?: boolean;
  /**
   * Path to a build-time OG card, e.g. /og/<slug>.png. Articles pass their own;
   * everything else falls through to the site card, so no page ever shares as a
   * bare grey box.
   */
  ogImage?: string;
  /** Alt text for the card. Defaults to the site card's own description. */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Keep the page out of search results (404, search results, thank-yous). */
  noindex?: boolean;
}

/** Last-resort description, so no page ships without one. */
const FALLBACK_DESCRIPTION =
  'আর-রিসালাহ — দাওয়াহ, চিন্তা ও গবেষণা। কুরআন ও সুন্নাহর আলোচনার সঙ্গে ইতিহাস, ' +
  'সমাজ ও সমকালীন বাস্তবতার পরিচয়, প্রয়োজনীয় দলিলসহ।';

const SITE_CARD = '/og/site.png';
const SITE_CARD_ALT = 'আর-রিসালাহ — ইসলামকে শুধু জানা নয়, বোঝা, ভাবা এবং জীবনে প্রয়োগ করা';

const {
  title,
  description = FALLBACK_DESCRIPTION,
  arabic = false,
  ogImage = SITE_CARD,
  ogImageAlt,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
const ogAlt = ogImageAlt ?? (ogImage === SITE_CARD ? SITE_CARD_ALT : title);
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="আর-রিসালাহ" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F7F5EF" />

    <meta property="og:site_name" content="আর-রিসালাহ" />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    {/* X reads og:* for most of this, but its own tags win where both exist,
        and several Bengali-facing readers only look at the twitter:* set. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {/* The two faces every page paints with. Preloading them removes the
        swap flash on the headline, which is the largest CLS risk here. */}
    <link rel="preload" href="/fonts/tiro-bangla-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-serif-bengali-400.woff2" as="font" type="font/woff2" crossorigin />
    {arabic && (
      <link rel="preload" href="/fonts/amiri-400.woff2" as="font" type="font/woff2" crossorigin />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">মূল বিষয়বস্তুতে যান</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>

<style is:global>
  /* The fixed mobile bar would otherwise sit on top of the last lines of an
     article. Reserve its height plus the home-indicator inset. */
  body { padding-bottom: calc(var(--tap) + env(safe-area-inset-bottom)); }
  @media (min-width: 64rem) { body { padding-bottom: 0; } }
</style>

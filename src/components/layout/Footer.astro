---
import Logo from './Logo.astro';
import { FOOTER_NAV, LEGAL_NAV, SOCIAL, SITE } from '../../lib/nav';
import { toBn } from '../../lib/toBn';

const year = toBn(new Date().getFullYear());

/**
 * Inline 20×20 glyphs on a 24-box. Keeping them here rather than in a sprite
 * means the footer has no extra request and no icon dependency; there are five
 * of them and they never change.
 */
const ICONS: Record<string, string> = {
  facebook:
    'M14 8.5V7c0-.7.3-1 1-1h1.5V3.5H14c-2.2 0-3.5 1.4-3.5 3.4V8.5H8.5V11h2v9.5H14V11h2.3l.4-2.5H14Z',
  youtube:
    'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12c0 1.6.1 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.3-1.6.4-3.2.4-4.8s-.1-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z',
  telegram:
    'M21.9 4.3 18.7 19.4c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-4.9 9-8.1c.4-.3-.1-.5-.6-.2L6.2 12.1 1.4 10.6c-1-.3-1-1 .2-1.5l19-7.3c.9-.3 1.6.2 1.3 2.5Z',
  whatsapp:
    'M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.6 14.1c-.2.6-1.2 1.2-1.7 1.3-.5.1-1 .1-1.6-.1l-1.8-.7a11 11 0 0 1-4.3-4.4c-.5-.9-.8-1.9-.8-2.7 0-.9.4-1.7 1-2.2.2-.2.4-.3.6-.3h.5c.2 0 .4 0 .6.4l.8 1.9c.1.2 0 .4-.1.6l-.4.5c-.1.2-.3.3-.1.6.5.9 1.1 1.6 1.9 2.2l1 .6c.2.1.4.1.6-.1l.8-.9c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.4.4 0 .2 0 .9-.2 1.5Z',
  x: 'M17.5 3h3.2l-7 8 8.2 10h-6.4l-5-6.1L4.7 21H1.5l7.5-8.6L1.2 3h6.6l4.5 5.6L17.5 3Zm-1.1 16.1h1.8L7.7 4.8H5.8l10.6 14.3Z',
};
---
<footer class="footer">
  <div class="container">
    {/* Capture sits at the very top of the footer, not buried under the link
        columns — this is the last thing a reader passes on every page. */}
    <div class="join">
      <div class="join-text">
        <h2>সপ্তাহে একটি লেখা। এর বেশি নয়।</h2>
        <p>
          প্রতি বৃহস্পতিবার সকালে নতুন প্রবন্ধ প্রকাশিত হয়—জুমার আগের দিন,
          ইচ্ছা করেই। সঙ্গে থাকে গবেষণা স্তর, খুতবার খসড়া ও লিফলেট।
        </p>
      </div>

      <div class="join-actions">
        {/* Not wired to a backend yet; the endpoint lands with the mailing
            list. Until then it posts nowhere and says so. */}
        <form class="join-form" method="post" action="#" aria-label="নিউজলেটারে যুক্ত হোন">
          <label class="visually-hidden" for="footer-email">ইমেইল ঠিকানা</label>
          <input
            id="footer-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="আপনার ইমেইল ঠিকানা"
          />
          <button type="submit">যুক্ত হোন</button>
        </form>
        <p class="join-alt">
          <a href="/subscribe">হোয়াটসঅ্যাপে পেতে চান? এখানে দেখুন →</a>
        </p>
        <p class="join-note">
          ঠিকানা কারও সঙ্গে ভাগ করা হয় না। এক ক্লিকে বেরিয়ে যেতে পারবেন।
        </p>
      </div>
    </div>

    <div class="top">
      <div class="brand">
        <Logo height={28} onDark={true} />
        <p class="tagline">{SITE.tagline}</p>
        <ul class="social">
          {SOCIAL.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} title={s.label}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={ICONS[s.icon]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="groups">
        {FOOTER_NAV.map((group) => (
          <nav class="group" aria-labelledby={`f-${group.heading}`}>
            <p class="heading" id={`f-${group.heading}`}>{group.heading}</p>
            <ul>
              {group.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="bottom">
      <p class="copy">© {year} {SITE.name}। সর্বস্বত্ব সংরক্ষিত নয়—উৎস উল্লেখ করে অবাধে ছড়িয়ে দিন।</p>
      <ul class="legal">
        {LEGAL_NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--deep);
    color: var(--paper);
    padding-block: var(--sp-8) var(--sp-6);
    margin-top: var(--sp-7);
  }

  /* ---- Join block --------------------------------------------- */
  .join {
    display: grid;
    gap: var(--sp-6);
    padding-bottom: var(--sp-8);
    margin-bottom: var(--sp-8);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
  }
  .join h2 {
    color: var(--paper);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    max-width: 18ch;
  }
  .join-text p {
    margin-top: var(--sp-4);
    color: color-mix(in srgb, var(--paper) 78%, transparent);
    line-height: var(--leading-snug);
    max-width: 44ch;
  }

  .join-form { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .join-form input {
    flex: 1 1 14rem;
    min-height: var(--tap);
    padding-inline: var(--sp-4);
    border: 1px solid color-mix(in srgb, var(--paper) 32%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper) 6%, transparent);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .join-form input::placeholder { color: color-mix(in srgb, var(--paper) 55%, transparent); }
  .join-form input:hover { border-color: color-mix(in srgb, var(--paper) 52%, transparent); }
  .join-form button {
    min-height: var(--tap);
    padding-inline: var(--sp-5);
    border: 0;
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--deep);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .join-form button:hover { background: #FFFFFF; }
  .join-alt { margin-top: var(--sp-4); font-family: var(--font-ui); font-size: var(--step--1); }
  .join-alt a { color: var(--rubric-soft); text-underline-offset: 0.25em; }
  .join-alt a:hover { color: var(--paper); }
  .join-note {
    margin-top: var(--sp-3);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--paper) 58%, transparent);
  }

  /* ---- Link columns ------------------------------------------- */
  .top { display: grid; gap: var(--sp-7); }
  .brand { display: grid; gap: var(--sp-4); justify-items: start; align-content: start; }
  .tagline {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    max-width: 26ch;
  }

  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--sp-2); }
  .social a {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    margin-left: calc(var(--sp-3) * -1);
    border-radius: var(--radius);
    color: color-mix(in srgb, var(--paper) 76%, transparent);
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .social li:not(:first-child) a { margin-left: 0; }
  .social a:hover {
    color: var(--paper);
    background: color-mix(in srgb, var(--paper) 10%, transparent);
  }

  .groups { display: grid; gap: var(--sp-6); }
  .heading {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--rubric-soft);
    margin-bottom: var(--sp-3);
  }
  .group ul { list-style: none; margin: 0; padding: 0; }
  .group a {
    display: flex;
    align-items: center;
    min-height: 34px;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--paper) 82%, transparent);
    text-decoration: none;
  }
  .group a:hover { color: var(--paper); text-decoration: underline; }

  /* ---- Legal row ---------------------------------------------- */
  .bottom {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--paper) 68%, transparent);
  }
  .copy { max-width: 60ch; }
  .legal { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-4); }
  .legal a { color: inherit; text-decoration: none; }
  .legal a:hover { color: var(--paper); text-decoration: underline; }

  @media (min-width: 48rem) {
    .groups { grid-template-columns: repeat(2, 1fr); gap: var(--sp-6) var(--sp-5); }
  }

  @media (min-width: 64rem) {
    .join { grid-template-columns: 1fr 1fr; gap: var(--sp-8); align-items: start; }
    .top { grid-template-columns: 1fr 2.6fr; gap: var(--sp-8); }
    .groups { grid-template-columns: repeat(4, 1fr); gap: var(--sp-5); }
    .bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--sp-6);
    }
  }
</style>
